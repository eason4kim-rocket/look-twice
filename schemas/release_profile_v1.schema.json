{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://look-twice.dev/schemas/release-profile-v1.json",
  "title": "Look Twice ReleaseProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "display_name", "tagline", "capabilities", "headline_metrics", "artifact_identities", "limitations", "experiment_links", "default_replays", "profile_sha256"],
  "properties": {
    "schema_version": {"const": "look-twice.release-profile/v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "tagline": {"$ref": "#/$defs/localized"},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "headline_metrics": {"type": "array", "items": {"type": "object"}},
    "artifact_identities": {"type": "array", "items": {"type": "object", "required": ["artifact", "sha256"], "properties": {"artifact": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/localized"}},
    "experiment_links": {"type": "array", "items": {"type": "object"}},
    "default_replays": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"localized": {"type": "object", "additionalProperties": false, "required": ["en", "zh"], "properties": {"en": {"type": "string", "minLength": 1}, "zh": {"type": "string", "minLength": 1}}}}
}
